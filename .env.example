# Configuración de Dockraft
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
BACKUPS_DIR=./backups
TZ=America/Guayaquil

# Puertos expuestos en el Host (cambiar si ya tienes otro servidor o panel en el 25565)
PANEL_PORT=8000
MC_JAVA_PORT=25565
MC_BEDROCK_PORT=19132

# Usuario y Contraseña para proteger el panel web:
ADMIN_USER=admin
# Deja vacío para acceso directo sin contraseña en red local
ADMIN_PASSWORD=

# Clave secreta para firmar tokens de sesión.
# OBLIGATORIO en producción — genera una con: openssl rand -hex 32
# Si se deja vacío, se generará una temporal (las sesiones se pierden al reiniciar).
SECRET_KEY=

# Orígenes CORS permitidos (separados por coma). Dejar vacío para uso local/LAN sin restricciones.
# Ejemplo para producción: ALLOWED_ORIGINS=https://mipanel.example.com
ALLOWED_ORIGINS=
