# Configuración de Dockraft
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
BACKUPS_DIR=./backups
TZ=America/Guayaquil

# Puertos expuestos en el Host (cambiar si ya tienes otro servidor o panel en el 25565)
PANEL_PORT=8000
MC_JAVA_PORT=25565
MC_BEDROCK_PORT=19132

# Usuario y Contraseña para proteger el panel web:
ADMIN_USER=admin
# Deja vacío para acceso directo sin contraseña en red local
ADMIN_PASSWORD=

# Clave secreta para firmar tokens de sesión.
# OBLIGATORIO en producción — genera una con: openssl rand -hex 32
# Si se deja vacío, se generará una temporal (las sesiones se pierden al reiniciar).
SECRET_KEY=

# Orígenes CORS permitidos (separados por coma). Dejar vacío para uso local/LAN sin restricciones.
# Ejemplo para producción: ALLOWED_ORIGINS=https://mipanel.example.com
ALLOWED_ORIGINS=

# Seguridad de sesión
# Activa el flag Secure en las cookies. OBLIGATORIO si el panel está detrás de un proxy HTTPS (Nginx, Caddy).
# Con HTTPS_ENABLED=false las cookies solo viajan por HTTP (adecuado para uso en red local sin TLS).
HTTPS_ENABLED=false

# Número máximo de intentos de login fallidos antes de bloquear la IP
LOGIN_MAX_ATTEMPTS=5
# Tiempo de bloqueo en segundos tras superar los intentos (600 = 10 minutos)
LOGIN_COOLDOWN_SECONDS=600
# Tiempo de sesión inactiva en minutos antes de expirar (60 = 1 hora)
SESSION_TIMEOUT_MINUTES=60
