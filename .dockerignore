# ==========================================
# Dockraft - Docker Ignore Rules
# ==========================================

# Servidor, copias de seguridad y datos persistentes (se gestionan a través de volúmenes)
data/
backups/
instancias/
launcher_config.json
.dockraft_root
.dockraft_state/
*.jar
*.zip
*.tar
*.gz
*.rar
bedrock-server*
bedrock_server*
eula.txt
server.properties
session.lock
*.pid

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/

# Archivos de compilación, caché de Python y empaquetado de escritorio
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
AppDir/
packaging/
launcher.py
*.AppImage
*.exe
.venv-*/

# Tests y cobertura
tests/
.pytest_cache/
.coverage
htmlcov/

# Control de versiones, compose y CI/CD
.git/
.gitignore
.dockerignore
.github/
docker-compose.yml

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Documentación y archivos temporales de desarrollo
README.md
LICENSE
scratch/
docs/
*.tmp
.*.tmp.*
*.bak

# IDEs, agentes y sistemas operativos
.idea/
.vscode/
.gemini/
.agents/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs temporales
*.log
