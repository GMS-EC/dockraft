# ==========================================
# Dockraft - Git Ignore Rules
# ==========================================

# Datos del servidor Minecraft, instancias locales y respaldos
data/
backups/
instancias/
launcher_config.json
.dockraft_root
*.jar
*.zip
*.tar
*.gz
*.rar
bedrock-server*
bedrock_server*
server.properties
eula.txt
session.lock
*.pid
*.log

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/

# Caché, compilación de Python y artefactos de empaquetado (Windows / AppImage)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
AppDir/
*.AppImage
*.exe
.venv-*/

# Tests, temporales y cobertura
scratch/
.dockraft_state/
.pytest_cache/
.coverage
htmlcov/
*.tmp
.*.tmp.*
*.bak

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# IDEs, agentes y editores
.idea/
.vscode/
.gemini/
.agents/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
